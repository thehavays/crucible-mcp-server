# ==============================================================================
# Crucible MCP Server - Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL!
# ==============================================================================

# Base URL of your self-hosted Atlassian Crucible instance
CRUCIBLE_URL=https://crucible.example.com

# Basic Authentication Credentials
CRUCIBLE_USERNAME=your_username
CRUCIBLE_PASSWORD=your_password

# Alternative API Token Authentication (if configured instead of basic auth)
# CRUCIBLE_API_TOKEN=your_token_here
